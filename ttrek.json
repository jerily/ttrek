{
  "name": "ttrek",
  "version": "1.1.0",
  "scripts": {
    "prepare-linux-amd64-glibc": "exec \"$PROJECT_HOME/bin/prepare-linux.sh\" amd64 glibc \"$@\"",
    "prepare-linux-arm64-glibc": "exec \"$PROJECT_HOME/bin/prepare-linux.sh\" arm64 glibc \"$@\"",
    "prepare-linux-amd64-musl": "exec \"$PROJECT_HOME/bin/prepare-linux.sh\" amd64 musl \"$@\"",
    "prepare-linux-arm64-musl": "exec \"$PROJECT_HOME/bin/prepare-linux.sh\" arm64 musl \"$@\"",
    "test-linux-amd64": "exec \"$PROJECT_HOME/bin/test-linux-release.sh\" amd64 \"$@\"",
    "test-linux-arm64": "exec \"$PROJECT_HOME/bin/test-linux-release.sh\" arm64 \"$@\"",
    "prepare-macos-target-11.0": "exec \"$PROJECT_HOME/bin/prepare-macos-target-11.0.sh\" \"$@\"",
    "prepare-macos-arm64": "exec \"$PROJECT_HOME/bin/prepare-macos.sh\" arm64 \"$@\"",
    "prepare-macos-x86_64": "exec \"$PROJECT_HOME/bin/prepare-macos.sh\" x86_64 \"$@\"",
    "prepare-macos-universal2": "exec \"$PROJECT_HOME/bin/prepare-universal2.sh\" \"$@\"",
    "upload-local": "exec \"$PROJECT_HOME/bin/upload.sh\" local \"$@\"",
    "upload-prod": "exec \"$PROJECT_HOME/bin/upload.sh\" prod \"$@\""
  },
  "useFlags": [
    "+static"
  ],
  "dependencies": {
    "zlib": "=1.3.2",
    "openssl": "=3.5.9",
    "cjson": "=1.7.19",
    "curl": "=8.23.0",
    "tcl": "=9.1.0",
    "libgit2": "=1.9.7",
    "libarchive": "=3.8.11",
    "satdepsolver": "=0.6.0",
    "ttrie": "=0.1.1",
    "ttrigrams": "=0.1.0"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "CMAKE_BUILD_TYPE",
            "value": "Release"
          },
          {
            "name": "BUILD_TESTING",
            "value": "ON"
          },
          {
            "name": "satdepsolver_DIR",
            "value": "$INSTALL_DIR/lib/cmake/satdepsolver"
          }
        ]
      },
      {
        "cmd": "cmake_make",
        "parallel": true
      },
      {
        "cmd": "env_variable",
        "name": "CTEST_OUTPUT_ON_FAILURE",
        "op": "set",
        "value": "1"
      },
      {
        "cmd": "make",
        "options": [
          {
            "name": "test"
          }
        ]
      },
      {
        "cmd": "cmake_install"
      }
    ]
  }
}
