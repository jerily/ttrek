{
  "name": "ttrek",
  "version": "1.1.0",
  "scripts": {
    "prepare-linux-amd64-glibc": {
      "file": "bin/prepare-linux.sh",
      "args": [
        "amd64",
        "glibc"
      ]
    },
    "prepare-linux-arm64-glibc": {
      "file": "bin/prepare-linux.sh",
      "args": [
        "arm64",
        "glibc"
      ]
    },
    "prepare-linux-amd64-musl": {
      "file": "bin/prepare-linux.sh",
      "args": [
        "amd64",
        "musl"
      ]
    },
    "prepare-linux-arm64-musl": {
      "file": "bin/prepare-linux.sh",
      "args": [
        "arm64",
        "musl"
      ]
    },
    "test-linux-amd64": {
      "file": "bin/test-linux-release.sh",
      "args": [
        "amd64"
      ]
    },
    "test-linux-arm64": {
      "file": "bin/test-linux-release.sh",
      "args": [
        "arm64"
      ]
    },
    "prepare-macos-target-11.0": {
      "file": "bin/prepare-macos-target-11.0.sh"
    },
    "prepare-macos-arm64": {
      "file": "bin/prepare-macos.sh",
      "args": [
        "arm64"
      ]
    },
    "prepare-macos-x86_64": {
      "file": "bin/prepare-macos.sh",
      "args": [
        "x86_64"
      ]
    },
    "prepare-macos-universal2": {
      "file": "bin/prepare-universal2.sh"
    },
    "upload-local": {
      "file": "bin/upload.sh",
      "args": [
        "local"
      ]
    },
    "upload-prod": {
      "file": "bin/upload.sh",
      "args": [
        "prod"
      ]
    }
  },
  "useFlags": [
    "+static"
  ],
  "dependencies": {
    "zlib": "=1.3.2",
    "openssl": "=3.5.9",
    "cjson": "=1.7.19",
    "curl": "=8.23.0",
    "tcl": "=9.1.0",
    "libgit2": "=1.9.7",
    "libarchive": "=3.8.11",
    "satdepsolver": "=0.6.0",
    "ttrie": "=0.1.1",
    "ttrigrams": "=0.1.0"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "CMAKE_BUILD_TYPE",
            "value": "Release"
          },
          {
            "name": "BUILD_TESTING",
            "value": "ON"
          },
          {
            "name": "satdepsolver_DIR",
            "value": "$INSTALL_DIR/lib/cmake/satdepsolver"
          }
        ]
      },
      {
        "cmd": "cmake_make",
        "parallel": true
      },
      {
        "cmd": "env_variable",
        "name": "CTEST_OUTPUT_ON_FAILURE",
        "op": "set",
        "value": "1"
      },
      {
        "cmd": "make",
        "options": [
          {
            "name": "test"
          }
        ]
      },
      {
        "cmd": "cmake_install"
      }
    ]
  }
}
