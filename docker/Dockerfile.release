# syntax=docker/dockerfile:1
ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE} AS build

ARG TARGETARCH
ARG JOBS=2
RUN case "$TARGETARCH" in amd64|arm64) ;; *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; esac; \
    if command -v apk >/dev/null 2>&1; then \
        apk add --no-cache bash build-base bsd-compat-headers ca-certificates cmake coreutils curl git \
            linux-headers patch perl pkgconf python3 tar gzip; \
    else \
        apt-get update && \
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
            bash build-essential ca-certificates cmake curl git patch perl pkg-config python3 tar gzip && \
        rm -rf /var/lib/apt/lists/*; \
    fi

WORKDIR /src
COPY build-ttrek.sh CMakeLists.txt ./
COPY cmake/ cmake/
COPY docs/ docs/
COPY src/ src/
COPY tests/ tests/

# Each target runs its own compiler and tests, natively or through Docker emulation.
RUN JOBS="$JOBS" TTREK_MAKE_THREADS="$JOBS" \
        TTREK_BUILD_DIR="/build/$TARGETARCH" TTREK_INSTALL_DIR="/install/$TARGETARCH" \
        bash ./build-ttrek.sh && \
    mkdir /out && cp "/build/$TARGETARCH/ttrek" /out/ttrek

FROM scratch AS release
COPY --from=build /out/ttrek /ttrek
