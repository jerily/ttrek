# syntax=docker/dockerfile:1
# Use bin/prepare-linux.sh to select the pinned image for each architecture.
ARG BASE_IMAGE=quay.io/pypa/manylinux_2_28_x86_64@sha256:9555ba6c479fa69a2aa80ad1dc57154a60d562b19df159361d9379a02beb1e36
FROM ${BASE_IMAGE} AS build

ARG TARGETARCH
ARG LIBC=glibc
ARG JOBS=2
RUN case "$TARGETARCH" in amd64|arm64) ;; *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; esac; \
    if command -v apk >/dev/null 2>&1; then \
        test "$LIBC" = musl && \
        apk add --no-cache bash binutils build-base bsd-compat-headers ca-certificates cmake coreutils curl git \
            linux-headers patch perl pkgconf python3 tar gzip; \
    else \
        test "$LIBC" = glibc && test "$(getconf GNU_LIBC_VERSION)" = 'glibc 2.28' && \
        dnf install -y bash binutils ca-certificates curl git make patch perl pkgconf-pkg-config tar gzip && \
        dnf clean all; \
    fi

WORKDIR /src
COPY build-ttrek.sh ./
# All dependency artifacts stay inside this architecture/libc-specific image.
RUN JOBS="$JOBS" TTREK_MAKE_THREADS="$JOBS" TTREK_DEPS_ONLY=1 \
        TTREK_BUILD_DIR="/build/$TARGETARCH" TTREK_INSTALL_DIR="/install/$TARGETARCH" \
        bash ./build-ttrek.sh

COPY CMakeLists.txt ./
COPY ttrek.json ./
COPY cmake/ cmake/
COPY docs/ docs/
COPY src/ src/
COPY tests/ tests/
COPY bin/check-linux-release.py bin/check-linux-release.py

# Each target runs its own compiler and tests, natively or through Docker emulation.
RUN JOBS="$JOBS" TTREK_MAKE_THREADS="$JOBS" TTREK_SKIP_DEPS=1 \
        TTREK_BUILD_DIR="/build/$TARGETARCH" TTREK_INSTALL_DIR="/install/$TARGETARCH" \
        bash ./build-ttrek.sh && \
    python3 bin/check-linux-release.py "/build/$TARGETARCH/ttrek" "$TARGETARCH" "$LIBC" && \
    mkdir /out && cp "/build/$TARGETARCH/ttrek" /out/ttrek

FROM scratch AS release
COPY --from=build /out/ttrek /ttrek
