FROM alpine:3.23
ENV TZ=UTC
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
RUN apk add \
    ca-certificates \
    linux-headers \
    bsd-compat-headers \
    bash \
    perl \
    gcc \
    g++ \
    binutils-gold \
    cmake \
    coreutils \
    make \
    patch \
    pkgconfig \
    python3 \
    tar \
    gzip \
    cvs \
    git \
    curl \
    zip \
    unzip \
    gdb \
    libunwind-dev

COPY docs /var/ttrek/docs
COPY src /var/ttrek/src
COPY cmake /var/ttrek/cmake
COPY tests /var/ttrek/tests
COPY CMakeLists.txt /var/ttrek/CMakeLists.txt
COPY bin/check-linux-release.py /var/ttrek/bin/check-linux-release.py
COPY build-ttrek.sh /var/ttrek/build-ttrek.sh

ENV LD_LIBRARY_PATH="/var/www/sample-project/local/lib:/var/www/sample-project/local/lib64"

RUN chmod +x /var/ttrek/build-ttrek.sh
RUN /var/ttrek/build-ttrek.sh
